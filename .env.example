# Berithung v1.8 - AI Provider Configuration (OpenAI-compatible HTTP endpoint)
# Set these variables in your Vercel Project Environment Variables or local testing

# Required: API key for the AI provider
AI_API_KEY=

# Optional: Model name (Default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# Optional: Base URL for OpenAI-compatible endpoint (Default: https://api.openai.com/v1)
# Examples:
# - Groq: https://api.groq.com/openai/v1
# - DeepSeek: https://api.deepseek.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_BASE_URL=https://api.openai.com/v1
