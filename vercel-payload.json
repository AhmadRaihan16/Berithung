{"target": "production", "name": "menabung-app", "files": [{"file": "index.html", "data": "<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, viewport-fit=cover\" />\n  <meta name=\"theme-color\" content=\"#2563eb\" />\n  <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n  <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\" />\n  <title>Menabung</title>\n  <link rel=\"manifest\" href=\"manifest.json\" />\n  <style>\n    :root {\n      --bg: #f8fafc;\n      --card: #ffffff;\n      --text: #0f172a;\n      --muted: #64748b;\n      --border: #e2e8f0;\n      --accent: #2563eb;\n      --accent-2: #10b981;\n      --accent-3: #f59e0b;\n    }\n    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }\n    html, body { height: 100%; }\n    body {\n      margin: 0;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n      background: var(--bg);\n      color: var(--text);\n      padding: 16px;\n      padding-bottom: max(80px, env(safe-area-inset-bottom) + 16px);\n    }\n    .container { max-width: 480px; margin: 0 auto; }\n    h1 {\n      font-size: 22px;\n      margin: 8px 0 4px;\n    }\n    .sub { color: var(--muted); font-size: 13px; margin-bottom: 16px; }\n    .card {\n      background: var(--card);\n      border: 1px solid var(--border);\n      border-radius: 14px;\n      padding: 14px;\n      margin-bottom: 12px;\n    }\n    .row { display: flex; gap: 10px; align-items: center; }\n    .flex-1 { flex: 1; }\n    .muted { color: var(--muted); font-size: 12px; }\n    .big { font-size: 28px; font-weight: 700; letter-spacing: -0.5px; }\n    .accent { color: var(--accent); }\n    .green { color: var(--accent-2); }\n    .amber { color: var(--accent-3); }\n    .pill {\n      display: inline-block;\n      border-radius: 999px;\n      padding: 4px 10px;\n      font-size: 12px;\n      background: #eef2ff;\n      color: var(--accent);\n      border: 1px solid #e0e7ff;\n    }\n    input[type=\"number\"] {\n      width: 100%;\n      padding: 12px 12px;\n      border: 1px solid var(--border);\n      border-radius: 12px;\n      font-size: 16px;\n      background: #fff;\n    }\n    button {\n      border: none;\n      padding: 12px 14px;\n      border-radius: 12px;\n      font-size: 15px;\n      font-weight: 600;\n      cursor: pointer;\n      width: 100%;\n    }\n    .btn-primary { background: var(--accent); color: white; }\n    .btn-secondary { background: var(--accent-2); color: white; }\n    .btn-tertiary { background: #fff; color: var(--text); border: 1px solid var(--border); }\n    .btn:disabled { opacity: 0.6; }\n    .divider { height: 1px; background: var(--border); margin: 14px 0; }\n    .item { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }\n    .item:last-child { border-bottom: none; }\n    .empty { text-align: center; color: var(--muted); padding: 14px 0; font-size: 13px; }\n    .week-nav { display: flex; justify-content: space-between; align-items: center; }\n    .week-nav button { width: auto; padding: 8px 12px; }\n    .toast {\n      position: fixed;\n      bottom: 24px;\n      left: 50%;\n      transform: translateX(-50%);\n      background: #0f172a;\n      color: white;\n      padding: 10px 14px;\n      border-radius: 12px;\n      font-size: 13px;\n      z-index: 100;\n      opacity: 0;\n      transition: opacity .2s ease;\n      pointer-events: none;\n    }\n    .toast.show { opacity: 1; }\n    .fab {\n      position: fixed;\n      bottom: max(20px, env(safe-area-inset-bottom) + 10px);\n      right: 16px;\n      width: 56px; height: 56px;\n      border-radius: 999px;\n      background: var(--accent);\n      color: white;\n      display: grid; place-items: center;\n      font-size: 24px;\n      box-shadow: 0 8px 20px rgba(37, 99, 235, 0.35);\n      border: none;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"week-nav\">\n      <button class=\"btn-tertiary\" id=\"prevWeek\">\u2190</button>\n      <div style=\"text-align:center;\">\n        <div class=\"muted\" id=\"weekLabel\">Minggu ini</div>\n      </div>\n      <button class=\"btn-tertiary\" id=\"nextWeek\">\u2192</button>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"row\" style=\"justify-content:space-between;\">\n        <div>\n          <div class=\"muted\">Total minggu ini</div>\n          <div class=\"big\" id=\"totalWeek\">Rp 0</div>\n        </div>\n        <div class=\"pill\" id=\"streak\">0 minggu</div>\n      </div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"row\" style=\"justify-content:space-between;\">\n        <div>\n          <div class=\"muted\">Tabungan Darurat</div>\n          <div class=\"big green\" id=\"emergencyTotal\">Rp 0</div>\n        </div>\n        <button class=\"btn-secondary\" id=\"btnEmergency\" style=\"width:auto;padding:10px 12px;font-size:13px;\">+ Isi</button>\n      </div>\n      <div class=\"muted\" style=\"margin-top:8px;\">Target: bebas per minggu</div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"row\" style=\"justify-content:space-between;\">\n        <div>\n          <div class=\"muted\">Tabungan Barang Impian</div>\n          <div class=\"big amber\" id=\"wishlistTotal\">Rp 0</div>\n        </div>\n        <button class=\"btn-primary\" id=\"btnWishlist\" style=\"width:auto;padding:10px 12px;font-size:13px;\">+ Isi</button>\n      </div>\n      <div class=\"muted\" style=\"margin-top:8px;\">Target: nominal & item bebas</div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"muted\" style=\"margin-bottom:8px;\">Riwayat minggu ini</div>\n      <div id=\"history\"></div>\n    </div>\n  </div>\n\n  <div class=\"toast\" id=\"toast\"></div>\n\n  <script>\n    const STORE_KEY = 'savings_app_v2';\n    const EMERGENCY = 'emergency';\n    const WISHLIST = 'wishlist';\n\n    function getData() {\n      try {\n        return JSON.parse(localStorage.getItem(STORE_KEY)) || defaultData();\n      } catch { return defaultData(); }\n    }\n    function defaultData() {\n      return {\n        entries: [],\n        wishlistName: '',\n        wishlistTarget: 0,\n      };\n    }\n    function saveData(data) { localStorage.setItem(STORE_KEY, JSON.stringify(data)); }\n\n    function currentWeekKey() {\n      const d = new Date();\n      const start = new Date(d.getFullYear(), 0, 1 + (Math.floor((d - new Date(d.getFullYear(),0,1)) / 86400000) / 7 | 0) * 7 - ((new Date(d.getFullYear(),0,1).getDay()+6)%7));\n      const y1 = start.getFullYear();\n      const w1 = Math.floor((start - new Date(y1,0,1)) / 86400000 / 7) + 1;\n      return `${y1}-W${String(w1).padStart(2,'0')}`;\n    }\n\n    function formatRupiah(n) {\n      return 'Rp ' + Number(n||0).toLocaleString('id-ID');\n    }\n\n    function getWeekData(weekKey) {\n      const data = getData();\n      const items = (data.entries || []).filter(e => e.week === weekKey);\n      return items;\n    }\n\n    function render() {\n      const data = getData();\n      const weekKey = currentWeekKey();\n      const items = getWeekData(weekKey);\n\n      const emergency = items.filter(i => i.type === EMERGENCY).reduce((a,b) => a + Number(b.amount||0), 0);\n      const wishlist = items.filter(i => i.type === WISHLIST).reduce((a,b) => a + Number(b.amount||0), 0);\n      const total = emergency + wishlist;\n\n      document.getElementById('emergencyTotal').textContent = formatRupiah(emergency);\n      document.getElementById('wishlistTotal').textContent = formatRupiah(total);\n      document.getElementById('totalWeek').textContent = formatRupiah(total);\n\n      const weeks = new Set((data.entries || []).map(e => e.week));\n      document.getElementById('streak').textContent = `${weeks.size} minggu`;\n\n      if (data.wishlistName) {\n        document.getElementById('wishlistTotal').textContent = `${formatRupiah(wishlist)} (${data.wishlistName})`;\n      }\n\n      const historyEl = document.getElementById('history');\n      if (!items.length) {\n        historyEl.innerHTML = '<div class=\"empty\">Belum ada transaksi minggu ini.</div>';\n        return;\n      }\n      historyEl.innerHTML = items.map(it => `\n        <div class=\"item\">\n          <div>\n            <div>${it.type === EMERGENCY ? 'Darurat' : data.wishlistName || 'Barang Impian'}</div>\n            <div class=\"muted\">${it.date} ${it.note ? '\u00b7 ' + it.note : ''}</div>\n          </div>\n          <div style=\"font-weight:600;\">+${formatRupiah(it.amount)}</div>\n        </div>\n      `).join('');\n    }\n\n    function add(type) {\n      const amount = prompt(`Masukkan nominal ${type === EMERGENCY ? 'Darurat' : (getData().wishlistName || 'Barang Impian')}:`);\n      if (amount === null) return;\n      const value = Number(String(amount).replace(/[^0-9]/g, ''));\n      if (!value || value <= 0) { showToast('Nominal tidak valid'); return; }\n      const note = prompt('Catatan (opsional):') || '';\n      const now = new Date();\n      const date = now.toLocaleDateString('id-ID', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });\n      const entry = { type, amount: value, note, date, week: currentWeekKey() };\n      const data = getData();\n      data.entries = data.entries || [];\n      data.entries.unshift(entry);\n      saveData(data);\n      render();\n      showToast('Tersimpan');\n    }\n\n    function showToast(text) {\n      const t = document.getElementById('toast');\n      t.textContent = text;\n      t.classList.add('show');\n      setTimeout(() => t.classList.remove('show'), 1800);\n    }\n\n    document.getElementById('btnEmergency').addEventListener('click', () => add(EMERGENCY));\n    document.getElementById('btnWishlist').addEventListener('click', () => add(WISHLIST));\n\n    render();\n\n    // Setup wishlist name/target\n    const data = getData();\n    if (!data.wishlistName) {\n      const name = prompt('Mau nabung buat apa? (misal: Laptop, Motor, Liburan)');\n      if (name) {\n        const target = prompt('Target nominal yang diinginkan (opsional):') || 0;\n        data.wishlistName = name.trim();\n        data.wishlistTarget = Number(String(target).replace(/[^0-9]/g, '')) || 0;\n        saveData(data);\n        render();\n      }\n    }\n\n    // Notification\n    if ('Notification' in window && Notification.permission === 'default') {\n      Notification.requestPermission();\n    }\n    function notify(title, body) {\n      if (!('Notification' in window) || Notification.permission !== 'granted') return;\n      try { new Notification(title, { body, icon: 'assets/icon-192.png' }); } catch {}\n    }\n    notify('Menabung', 'Jangan lupa isi tabungan minggu ini ya \ud83d\udcaa');\n\n    // Schedule daily reminder\n    if ('serviceWorker' in navigator) {\n      navigator.serviceWorker.register('sw.js').catch(()=>{});\n    }\n  </script>\n</body>\n</html>\n"}, {"file": "manifest.json", "data": "{\n  \"name\": \"Menabung - Tabungan Harian\",\n  \"short_name\": \"Menabung\",\n  \"description\": \"Aplikasi menabung mingguan dengan tabungan darurat dan barang impian\",\n  \"start_url\": \"index.html\",\n  \"display\": \"standalone\",\n  \"orientation\": \"portrait\",\n  \"background_color\": \"#f8fafc\",\n  \"theme_color\": \"#2563eb\",\n  \"icons\": [\n    {\n      \"src\": \"assets/icon-192.png\",\n      \"sizes\": \"192x192\",\n      \"type\": \"image/png\"\n    },\n    {\n      \"src\": \"assets/icon-512.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\"\n    }\n  ]\n}\n"}, {"file": "sw.js", "data": "self.addEventListener('install', (e) => { self.skipWaiting(); });\nself.addEventListener('activate', (e) => { e.waitUntil(self.clients.claim()); });\nself.addEventListener('fetch', (e) => {\n  e.respondWith(\n    caches.match(e.request).then(r => r || fetch(e.request).then(res => {\n      if (!res || res.status !== 200) return res;\n      const clone = res.clone();\n      caches.open('savings-v1').then(c => c.put(e.request, clone));\n      return res;\n    }).catch(() => caches.match('index.html')))\n  );\n});\n"}, {"file": "assets/icon-192.png", "data": "", "encoding": "base64"}, {"file": "assets/icon-512.png", "data": "", "encoding": "base64"}]}